{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "DF-factoryproject"
		},
		"azure sql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'azure sql'"
		},
		"datalake_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'datalake'"
		},
		"azure sql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "neelprojectserver.database.windows.net"
		},
		"azure sql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Spotify"
		},
		"azure sql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "neeldarji"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "DF-factoryproject_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"azure sql_password": {
						"value": "[parameters('azure sql_password')]"
					},
					"datalake_connectionString": {
						"value": "[parameters('datalake_connectionString')]"
					},
					"azure sql_properties_typeProperties_server": {
						"value": "[parameters('azure sql_properties_typeProperties_server')]"
					},
					"azure sql_properties_typeProperties_database": {
						"value": "[parameters('azure sql_properties_typeProperties_database')]"
					},
					"azure sql_properties_typeProperties_userName": {
						"value": "[parameters('azure sql_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}